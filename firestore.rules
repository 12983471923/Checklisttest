rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasProfile() {
      return signedIn() && exists(userPath());
    }

    function currentRole() {
      return hasProfile() ? get(userPath()).data.role : null;
    }

    function isActive() {
      return hasProfile() && get(userPath()).data.isActive != false;
    }

    function isManager() {
      return isActive() && currentRole() in ['manager', 'admin'];
    }

    function isAdmin() {
      return isActive() && currentRole() == 'admin';
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function ownProfileCreateIsSafe(userId) {
      return isSelf(userId)
        && request.resource.data.role == 'staff'
        && request.resource.data.isActive == true;
    }

    function ownProfileUpdateIsSafe(userId) {
      return isSelf(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName',
          'initials',
          'lastLogin',
          'updatedAt'
        ]);
    }

    match /users/{userId} {
      allow create: if ownProfileCreateIsSafe(userId);
      allow read: if isSelf(userId) || isManager();
      allow update: if ownProfileUpdateIsSafe(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /checklists/{document} {
      allow read, write: if isActive();
    }

    match /downtime/{document} {
      allow read, write: if isActive();
    }

    match /handover-notes/{document} {
      allow read, write: if isActive();
    }

    match /wake-up-calls/{document} {
      allow read, write: if isActive();
    }

    match /breakfast-times/{document} {
      allow read, write: if isActive();
    }

    match /auditTrail/{document} {
      allow read: if isManager();
      allow create: if isActive() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /backups/{document} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
