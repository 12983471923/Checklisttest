rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasProfile() {
      return signedIn() && exists(userPath());
    }

    function currentRole() {
      return hasProfile() ? get(userPath()).data.role : null;
    }

    function isActive() {
      return hasProfile() && get(userPath()).data.isActive != false;
    }

    // The single hardcoded admin email. Admin privileges require BOTH this
    // verified auth email AND the Firestore role == 'admin' (double-check).
    function adminEmail() {
      return 'admin@falkoner.com';
    }

    function hasAdminEmail() {
      return signedIn() && request.auth.token.email == adminEmail();
    }

    function isManager() {
      return isActive() && currentRole() in ['manager', 'admin'];
    }

    function isAdmin() {
      return isActive() && currentRole() == 'admin' && hasAdminEmail();
    }

    function isHousekeeping() {
      return isActive() && currentRole() == 'housekeeping';
    }

    function isReception() {
      return isActive() && currentRole() in ['staff', 'manager', 'admin'];
    }

    function isStaffPortalUser() {
      return isReception() || isHousekeeping();
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Prevent the database being abused as unlimited free storage
    function withinSizeLimit() {
      return request.resource.size() < 200 * 1024;
    }

    function ownProfileCreateIsSafe(userId) {
      return isSelf(userId)
        && request.resource.data.role == 'staff'
        && request.resource.data.isActive == true;
    }

    function ownProfileUpdateIsSafe(userId) {
      return isSelf(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName',
          'initials',
          'lastLogin',
          'updatedAt'
        ]);
    }

    // Users — own profile read/write with field-level constraints;
    // managers can read all; admins can do anything
    match /users/{userId} {
      allow create: if ownProfileCreateIsSafe(userId);
      allow read: if isSelf(userId) || isManager();
      allow update: if ownProfileUpdateIsSafe(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Operational checklists — active authenticated users only
    match /checklists/{document} {
      allow read: if isActive();
      allow write: if isActive() && withinSizeLimit();
    }

    match /downtime/{document} {
      allow read: if isActive();
      allow write: if isActive() && withinSizeLimit();
    }

    // Collection names match exactly what database.js uses
    match /handover-notes/{document} {
      allow read: if isActive();
      allow write: if isActive() && withinSizeLimit();
    }

    match /wake-up-calls/{document} {
      allow read: if isActive();
      allow write: if isActive() && withinSizeLimit();
    }

    match /breakfast-times/{document} {
      allow read: if isActive();
      allow write: if isActive() && withinSizeLimit()
        && (document != 'pricing' || isAdmin());
    }

    // Audit trail — managers read; any active user can append; no edits/deletes
    match /auditTrail/{document} {
      allow read: if isManager();
      allow create: if isActive()
        && withinSizeLimit()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Backups — admin only
    match /backups/{document} {
      allow read, write: if isAdmin();
    }

    // Shift configuration (task definitions, instructions, downtime times).
    // Any active staff member may read it (the checklist is built from it),
    // but only the admin may modify it.
    match /shiftConfig/{document} {
      allow read: if isActive();
      allow write: if isAdmin() && withinSizeLimit();
    }

    // Explore Copenhagen content — all active staff read and edit (approval in app)
    match /exploreContent/{document} {
      allow read: if isActive();
      allow write: if isActive() && withinSizeLimit();
    }

    // Housekeeping portal — rooms (reception manages, HSK reads/updates status)
    match /hsk-rooms/{roomId} {
      allow read: if isStaffPortalUser();
      allow create, delete: if isReception() && withinSizeLimit();
      allow update: if (isReception() || isHousekeeping()) && withinSizeLimit();
    }

    // Housekeeping requests — reception creates, both roles update status/comments
    match /hsk-requests/{requestId} {
      allow read: if isStaffPortalUser();
      allow create: if isReception() && withinSizeLimit();
      allow update: if isStaffPortalUser() && withinSizeLimit();
      allow delete: if isReception();
    }

    // Internal messaging between reception and housekeeping
    match /hsk-messages/{messageId} {
      allow read: if isStaffPortalUser();
      allow create: if isStaffPortalUser() && withinSizeLimit();
      allow update: if isStaffPortalUser() && withinSizeLimit();
      allow delete: if false;
    }

    // Ephemeral typing indicators for HSK chat
    match /hsk-typing/{userId} {
      allow read: if isStaffPortalUser();
      allow create, update: if isStaffPortalUser()
        && request.auth.uid == userId
        && withinSizeLimit();
      allow delete: if isStaffPortalUser() && request.auth.uid == userId;
    }

    // Shared housekeeping checklist
    match /hsk-checklists/{document} {
      allow read: if isStaffPortalUser();
      allow write: if isStaffPortalUser() && withinSizeLimit();
    }

    // Team handover notes — all active staff; admin can delete
    match /team-handovers/{handoverId} {
      allow read: if isActive();
      allow create: if isActive()
        && withinSizeLimit()
        && request.resource.data.authorId == request.auth.uid;
      allow update: if isActive() && withinSizeLimit();
      allow delete: if isAdmin();
    }

    // Dashboard layout customization — admin writes, all staff read
    match /dashboardConfig/{document} {
      allow read: if isActive();
      allow write: if isAdmin() && withinSizeLimit();
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
